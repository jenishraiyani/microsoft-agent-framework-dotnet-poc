# ---------------------------------------------------------------------------
# AgentPoc configuration example.
# Copy to ".env" (git-ignored) or export these as real environment variables.
# NEVER put real secrets in this file — it is committed to source control.
#
# Environment variables map onto appsettings.json keys using "__" as the
# section separator, which is the standard .NET configuration convention.
# ---------------------------------------------------------------------------

# Which model provider the composition root should wire up: AzureOpenAI | OpenAI
AGENT__PROVIDER=AzureOpenAI

# --- Option A: Azure OpenAI ------------------------------------------------
# The resource endpoint, e.g. https://my-resource.openai.azure.com/
AGENT__AZUREOPENAI__ENDPOINT=
# The *deployment* name you created in Azure AI Foundry (not the model name).
AGENT__AZUREOPENAI__DEPLOYMENTNAME=

# Leave the API key EMPTY to use Microsoft Entra ID (DefaultAzureCredential).
# That is the recommended production setup: there is no secret to store or leak.
# Locally, run `az login` and grant yourself "Cognitive Services OpenAI User".
AGENT__AZUREOPENAI__APIKEY=

# --- Option B: OpenAI, or any OpenAI-compatible endpoint --------------------
# Only read when AGENT__PROVIDER=OpenAI.
# Leave ENDPOINT empty for OpenAI itself. The model MUST support tool calling.
AGENT__OPENAI__MODELID=gpt-4o-mini
AGENT__OPENAI__APIKEY=
AGENT__OPENAI__ENDPOINT=

# Free alternatives that speak the same protocol — see the README:
#
#   GitHub Models (free tier, needs a GitHub PAT with the models:read scope)
#     AGENT__PROVIDER=OpenAI
#     AGENT__OPENAI__ENDPOINT=https://models.github.ai/inference
#     AGENT__OPENAI__MODELID=openai/gpt-4o-mini
#     AGENT__OPENAI__APIKEY=<your GitHub PAT>
#
#   Ollama (free, runs locally; pick a model with tool-calling support)
#     AGENT__PROVIDER=OpenAI
#     AGENT__OPENAI__ENDPOINT=http://localhost:11434/v1
#     AGENT__OPENAI__MODELID=qwen3
#     AGENT__OPENAI__APIKEY=ollama

# --- Agent behaviour -------------------------------------------------------
# Hard ceiling on a single agent run, in seconds (5-300). Protects the API from
# a model or tool that never returns.
AGENT__RUNTIMEOUTSECONDS=60

# How long an idle conversation stays in the session store, in minutes (1-1440).
AGENT__SESSIONIDLETIMEOUTMINUTES=30

# --- Demo identity ---------------------------------------------------------
# The POC has no identity provider, so this customer is assumed when no
# authenticated principal is present. Replace with real authentication before
# this goes anywhere near production.
CUSTOMERIDENTITY__DEVELOPMENTCUSTOMERID=CUST-001
