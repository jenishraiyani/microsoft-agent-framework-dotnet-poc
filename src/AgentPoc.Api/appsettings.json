{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AgentPoc": "Information"
    }
  },
  "AllowedHosts": "*",

  "//": "No secrets live in this file. Supply Endpoint / DeploymentName / ApiKey through environment variables or user-secrets; see .env.example.",
  "Agent": {
    "Provider": "AzureOpenAI",
    "RunTimeoutSeconds": 60,
    "SessionIdleTimeoutMinutes": 30,
    "AzureOpenAI": {
      "Endpoint": "",
      "DeploymentName": "",
      "ApiKey": ""
    },
    "OpenAI": {
      "ModelId": "gpt-4o-mini",
      "ApiKey": "",
      "Endpoint": ""
    }
  },

  "CustomerIdentity": {
    "DevelopmentCustomerId": "CUST-001",
    "AllowHeaderOverrideInDevelopment": true
  }
}
